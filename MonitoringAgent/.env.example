# Copy to .env for local docker-compose runs. Real values only ever live in
# Azure Key Vault in deployed environments (see infra/keyvault.tf) — this
# file only carries the *shape* of the configuration.

# --- Connector modes: "stub" (default, fake data) or "live" (real credentials required) ---
GOLD_MODE=stub
RELEX_MODE=stub
GENERIX_MODE=stub

# --- GOLD (Oracle) — required only when GOLD_MODE=live ---
ORACLE_DSN=
ORACLE_USER=
ORACLE_PASSWORD=
AIRFLOW_BASE_URL=
AIRFLOW_TOKEN=

# --- RELEX — required only when RELEX_MODE=live ---
RELEX_BASE_URL=
RELEX_OTEL_URL=
RELEX_OAUTH_TOKEN_URL=
RELEX_CLIENT_ID=
RELEX_CLIENT_SECRET=
RELEX_API_KEY=

# --- Generix / Infolog WMS — required only when GENERIX_MODE=live ---
GENERIX_BASE_URL=
GENERIX_API_KEY=

# --- Agent ---
POLL_INTERVAL_SECONDS=60

# --- Persistance de l'historique des indicateurs (Prometheus) ---
# Nombre de jours d'historique conservés par Prometheus. Les données vivent
# dans le volume Docker nommé "prometheus_data" (survit aux redémarrages).
PROMETHEUS_RETENTION_DAYS=90

# --- Grafana (local only) ---
GRAFANA_ADMIN_PASSWORD=admin

# --- Alerte Teams (Grafana route les alertes vers ce webhook, specs.md §9.1) ---
# URL d'un connecteur "webhook entrant" créé sur un canal Teams. Laisser vide
# pour désactiver l'alerte (le dashboard reste fonctionnel sans).
TEAMS_WEBHOOK_URL=
