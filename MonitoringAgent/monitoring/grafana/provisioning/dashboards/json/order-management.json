{
  "title": "Order Management — Supervision",
  "uid": "order-management-supervision",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Le processus a-t-il bien tourné cette nuit ? (indicateur de tête)",
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 0 },
      "targets": [
        { "expr": "order_mgmt_chapeau_status{code=\"TETE\"}", "legendFormat": "TETE" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "OK", "color": "green" } } },
            { "type": "value", "options": { "1": { "text": "WARNING", "color": "orange" } } },
            { "type": "value", "options": { "2": { "text": "CRITICAL", "color": "red" } } },
            { "type": "value", "options": { "3": { "text": "UNKNOWN", "color": "grey" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Indicateurs chapeau",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 5 },
      "targets": [
        { "expr": "order_mgmt_chapeau_status{code!=\"TETE\"}", "legendFormat": "{{code}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "OK", "color": "green" } } },
            { "type": "value", "options": { "1": { "text": "WARNING", "color": "orange" } } },
            { "type": "value", "options": { "2": { "text": "CRITICAL", "color": "red" } } },
            { "type": "value", "options": { "3": { "text": "UNKNOWN", "color": "grey" } } }
          ]
        }
      }
    },
    {
      "type": "table",
      "title": "Indicateurs unitaires (§6)",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 11 },
      "targets": [
        { "expr": "order_mgmt_indicator_status", "format": "table", "instant": true, "legendFormat": "{{code}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cycles de collecte de l'agent",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 23 },
      "targets": [
        { "expr": "order_mgmt_poll_cycle_success", "legendFormat": "Dernier cycle OK" }
      ]
    }
  ]
}
