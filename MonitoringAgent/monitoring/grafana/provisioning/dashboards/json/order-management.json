{
  "title": "Order Management — Tableau de bord de direction",
  "uid": "order-management-supervision",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    { "type": "row", "title": "L'ESSENTIEL DU JOUR", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": [] },

    {
      "type": "stat",
      "title": "Magasins servis à temps (objectif 99 %)",
      "datasource": { "type": "prometheus", "uid": "prometheus_ordermgmt" },
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 1 },
      "targets": [
        { "expr": "100 * order_mgmt_dashboard_essentiel{metric=\"stores_reported\"} / order_mgmt_dashboard_essentiel{metric=\"stores_expected\"}", "legendFormat": "Servis à temps" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "orange", "value": 95 },
            { "color": "green", "value": 99 }
          ] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Commandes parties à l'heure",
      "datasource": { "type": "prometheus", "uid": "prometheus_ordermgmt" },
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 1 },
      "targets": [
        { "expr": "100 * (order_mgmt_dashboard_essentiel{metric=\"wms_orders_sent\"} - order_mgmt_dashboard_essentiel{metric=\"wms_orders_late\"}) / order_mgmt_dashboard_essentiel{metric=\"wms_orders_sent\"}", "legendFormat": "À l'heure" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "orange", "value": 97 },
            { "color": "green", "value": 99.5 }
          ] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Chaîne disponible (24 h)",
      "description": "% du temps où RELEX, GOLD et WMS sont simultanément disponibles (E2E-3), sur les dernières 24h.",
      "datasource": { "type": "prometheus", "uid": "prometheus_ordermgmt" },
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 1 },
      "targets": [
        { "expr": "100 * avg_over_time((order_mgmt_indicator_status{code=\"E2E-3\"} == bool 0)[24h:5m])", "legendFormat": "Disponibilité" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "orange", "value": 95 },
            { "color": "green", "value": 99 }
          ] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Durée du cycle (objectif 6 h)",
      "datasource": { "type": "prometheus", "uid": "prometheus_ordermgmt" },
      "gridPos": { "h": 6, "w": 4, "x": 12, "y": 1 },
      "targets": [
        { "expr": "order_mgmt_indicator_value{code=\"E2E-1\"} / 3600", "legendFormat": "Lead time" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 6 },
            { "color": "red", "value": 8 }
          ] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Cycles sans incident",
      "datasource": { "type": "prometheus", "uid": "prometheus_ordermgmt" },
      "gridPos": { "h": 6, "w": 4, "x": 16, "y": 1 },
      "targets": [
        { "expr": "order_mgmt_indicator_value{code=\"E2E-4\"}", "legendFormat": "Nominaux" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "orange", "value": 90 },
            { "color": "green", "value": 100 }
          ] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Interventions manuelles (objectif 0)",
      "datasource": { "type": "prometheus", "uid": "prometheus_ordermgmt" },
      "gridPos": { "h": 6, "w": 4, "x": 20, "y": 1 },
      "targets": [
        { "expr": "order_mgmt_indicator_value{code=\"E2E-5\"}", "legendFormat": "Aujourd'hui" },
        { "expr": "order_mgmt_indicator_value{code=\"E2E-5\"} - (order_mgmt_indicator_value{code=\"E2E-5\"} offset 1d)", "legendFormat": "Δ vs hier" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 1 },
            { "color": "red", "value": 3 }
          ] }
        }
      }
    },

    { "type": "row", "title": "OÙ EN EST LA CHAÎNE ?", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 }, "panels": [] },

    {
      "type": "stat",
      "title": "Remontée des ventes",
      "datasource": { "type": "prometheus", "uid": "prometheus_ordermgmt" },
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 8 },
      "targets": [{ "expr": "order_mgmt_chapeau_status{code=\"CHAPEAU-COLLECTE\"}" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": {
            "0": { "text": "Conforme", "color": "green" },
            "1": { "text": "À surveiller", "color": "orange" },
            "2": { "text": "En écart", "color": "red" },
            "3": { "text": "Non suivi", "color": "grey" }
          } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Calcul du réassort",
      "datasource": { "type": "prometheus", "uid": "prometheus_ordermgmt" },
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 8 },
      "targets": [{ "expr": "order_mgmt_chapeau_status{code=\"CHAPEAU-CALCUL\"}" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": {
            "0": { "text": "Conforme", "color": "green" },
            "1": { "text": "À surveiller", "color": "orange" },
            "2": { "text": "En écart", "color": "red" },
            "3": { "text": "Non suivi", "color": "grey" }
          } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Transmission des commandes",
      "datasource": { "type": "prometheus", "uid": "prometheus_ordermgmt" },
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 8 },
      "targets": [{ "expr": "order_mgmt_chapeau_status{code=\"CHAPEAU-TRANSMISSION\"}" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": {
            "0": { "text": "Conforme", "color": "green" },
            "1": { "text": "À surveiller", "color": "orange" },
            "2": { "text": "En écart", "color": "red" },
            "3": { "text": "Non suivi", "color": "grey" }
          } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Envoi à l'entrepôt",
      "datasource": { "type": "prometheus", "uid": "prometheus_ordermgmt" },
      "gridPos": { "h": 6, "w": 4, "x": 12, "y": 8 },
      "targets": [{ "expr": "order_mgmt_chapeau_status{code=\"CHAPEAU-DEPART-ENTREPOT\"}" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": {
            "0": { "text": "Conforme", "color": "green" },
            "1": { "text": "À surveiller", "color": "orange" },
            "2": { "text": "En écart", "color": "red" },
            "3": { "text": "Non suivi", "color": "grey" }
          } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Échange direct hors GOLD",
      "datasource": { "type": "prometheus", "uid": "prometheus_ordermgmt" },
      "gridPos": { "h": 6, "w": 4, "x": 16, "y": 8 },
      "targets": [{ "expr": "order_mgmt_chapeau_status{code=\"CHAPEAU-FLUX-DIRECT\"}" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": {
            "0": { "text": "Conforme", "color": "green" },
            "1": { "text": "À surveiller", "color": "orange" },
            "2": { "text": "En écart", "color": "red" },
            "3": { "text": "Non suivi — chantier prioritaire", "color": "grey" }
          } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      }
    },
    {
      "type": "text",
      "title": "Si une étape s'arrête",
      "gridPos": { "h": 6, "w": 4, "x": 20, "y": 8 },
      "options": {
        "mode": "markdown",
        "content": "**Rupture en rayon**\n\nRemontée, calcul, transmission, envoi entrepôt : impact fort si l'une de ces étapes s'arrête."
      }
    },

    { "type": "row", "title": "CE QUI DEMANDE UNE DÉCISION", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }, "panels": [] },

    {
      "type": "stat",
      "title": "À TRANCHER — commandes après cut-off",
      "datasource": { "type": "prometheus", "uid": "prometheus_ordermgmt" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 15 },
      "targets": [{ "expr": "order_mgmt_dashboard_essentiel{metric=\"wms_orders_late\"}", "legendFormat": "Commandes à statuer" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1 }
          ] }
        }
      }
    },
    {
      "type": "stat",
      "title": "À SURVEILLER — recours au flux de secours (7 derniers jours)",
      "datasource": { "type": "prometheus", "uid": "prometheus_ordermgmt" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 15 },
      "targets": [{ "expr": "count_over_time((order_mgmt_indicator_status{code=\"CAL-6\"} > 0)[7d:5m])", "legendFormat": "Cycles avec secours" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 1 },
            { "color": "red", "value": 5 }
          ] }
        }
      }
    },
    {
      "type": "text",
      "title": "À LANCER",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 15 },
      "options": {
        "mode": "markdown",
        "content": "**Mesurer l'échange direct RELEX ↔ WMS**\n\nAucune visibilité à ce jour — flux non qualifié (specs.md §6.5, §7)."
      }
    },

    {
      "type": "row",
      "title": "Diagnostic technique (indicateurs unitaires — pour l'exploitation)",
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
      "panels": [
        {
          "type": "table",
          "title": "Indicateurs unitaires (§6)",
          "datasource": { "type": "prometheus", "uid": "prometheus_ordermgmt" },
          "gridPos": { "h": 10, "w": 24, "x": 0, "y": 22 },
          "targets": [
            { "expr": "order_mgmt_indicator_status", "format": "table", "instant": true, "legendFormat": "{{code}}" }
          ]
        },
        {
          "type": "timeseries",
          "title": "Cycles de collecte de l'agent",
          "datasource": { "type": "prometheus", "uid": "prometheus_ordermgmt" },
          "gridPos": { "h": 6, "w": 24, "x": 0, "y": 32 },
          "targets": [
            { "expr": "order_mgmt_poll_cycle_success", "legendFormat": "Dernier cycle OK" }
          ]
        }
      ]
    }
  ]
}
